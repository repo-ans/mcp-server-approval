# --- Server ---
PORT=3000

# --- Housecall Pro ---
# true = return realistic fake data for everything (no API key needed). Great for demos.
HCP_MOCK=false
# true = real reads, but approved writes are SIMULATED (nothing is created in Housecall Pro).
# Set to false only when you really want approved actions written to your Housecall Pro account.
HCP_MOCK_WRITES=true
# Housecall Pro API key (Housecall Pro > App Store > API, MAX plan). Required unless HCP_MOCK=true.
HCP_API_KEY=
HCP_BASE_URL=https://api.housecallpro.com

# --- Supabase (Project Settings > API). Service role key is server-side only, never expose it. ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Slack approval gate ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
# Channel id (Channel details > About > bottom), e.g. C0123ABCD. Invite the bot to the channel.
SLACK_CHANNEL_ID=
# Optional: comma-separated Slack user ids allowed to approve (e.g. U012AB3CD,U045EF6GH). Empty = anyone in the channel.
SLACK_APPROVER_IDS=
# Slack user ids allowed to create/revoke API keys with /hcp-agent (profile > ... > Copy member ID). Empty = command off.
SLACK_ADMIN_IDS=

# --- Claude (job request workflow: email/PDF -> customer + job) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
